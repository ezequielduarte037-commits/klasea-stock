*GPDFileName: "P1.gpd"
*GPDFileVersion: "1.0"
*GPDSpecVersion: "1.0"
*Include: "StdNames.gpd"
*ModelName: "P1 Label Printer"
*MasterUnits: PAIR(203, 203)
*ResourceDLL: "P1UI.dll"
*PrinterType: PAGE
*MaxCopies: 9999
*%rcPrinterIconID:

*%******************************************************************************************
*%                                      Orientation
*%******************************************************************************************
*Feature: Orientation
{
    *rcNameID: =ORIENTATION_DISPLAY
    *DefaultOption: PORTRAIT
    *Option: PORTRAIT
    {
        *rcNameID: =PORTRAIT_DISPLAY
    }
    *Option: LANDSCAPE_CC270
    {
        *rcNameID: =LANDSCAPE_DISPLAY
    }
}

*%******************************************************************************************
*%                                      InputBin
*%******************************************************************************************
*Feature: InputBin
{
    *rcNameID: =PAPER_SOURCE_DISPLAY
    *DefaultOption: UPPER
    *Option: UPPER
    {
        *rcNameID: =UPPER_TRAY_DISPLAY
    }
}

*%******************************************************************************************
*%                                      Resolution
*%******************************************************************************************
*Feature: Resolution
{
    *rcNameID: =RESOLUTION_DISPLAY
    *DefaultOption: Option1
    *Option: Option1
    {
        *Name: "203 x 203" =DOTS_PER_INCH
        *DPI: PAIR(203, 203)
        *TextDPI: PAIR(203, 203)
        *PinsPerLogPass: 24
		*MinStripBlankPixels: 32
        *SpotDiameter: 170
        *Command: CmdSendBlockData { *Cmd : "" }
    }
}

*%******************************************************************************************
*%                                      Paper Size
*%******************************************************************************************
*Feature: PaperSize
{
    *rcNameID: =PAPER_SIZE_DISPLAY
    *DefaultOption: Option0
    *Option: Option0
    {
        *Name: "A 50 x  300 mm"
        *PageDimensions: PAIR(384, 2400)
        *PrintableArea: PAIR(384, 2400)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option1
    {
        *Name: "A 50 x 2000 mm"
        *PageDimensions: PAIR(384, 16000)
        *PrintableArea: PAIR(384, 16000)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option2
    {
        *Name: "B 25 x 75 mm"
        *PageDimensions: PAIR(200, 600)
        *PrintableArea: PAIR(200, 600)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option3
    {
        *Name: "C 30 x 20 mm"
        *PageDimensions: PAIR(240, 160)
        *PrintableArea: PAIR(240, 160)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option4
    {
        *Name: "C 30 x 60 mm"
        *PageDimensions: PAIR(240, 480)
        *PrintableArea: PAIR(240, 480)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option5
    {
        *Name: "C 30 x 80 mm"
        *PageDimensions: PAIR(240, 640)
        *PrintableArea: PAIR(240, 640)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option6
    {
        *Name: "C 30 x 90 mm"
        *PageDimensions: PAIR(240, 720)
        *PrintableArea: PAIR(240, 720)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option7
    {
        *Name: "C 35 x 70 mm"
        *PageDimensions: PAIR(280, 560)
        *PrintableArea: PAIR(280, 560)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option8
    {
        *Name: "C 35 x 80 mm"
        *PageDimensions: PAIR(280, 640)
        *PrintableArea: PAIR(280, 640)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option9
    {
        *Name: "C 38 x 60 mm"
        *PageDimensions: PAIR(304, 480)
        *PrintableArea: PAIR(304, 480)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option10
    {
        *Name: "D 40 x 30 mm"
        *PageDimensions: PAIR(320, 240)
        *PrintableArea: PAIR(320, 240)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option11
    {
        *Name: "D 40 x 60 mm"
        *PageDimensions: PAIR(320, 480)
        *PrintableArea: PAIR(320, 480)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option12
    {
        *Name: "D 40 x 70 mm"
        *PageDimensions: PAIR(320, 560)
        *PrintableArea: PAIR(320, 560)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option13
    {
        *Name: "D 40 x 80 mm"
        *PageDimensions: PAIR(320, 640)
        *PrintableArea: PAIR(320, 640)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option14
    {
        *Name: "D 40 x 90 mm"
        *PageDimensions: PAIR(320, 720)
        *PrintableArea: PAIR(320, 720)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option15
    {
        *Name: "D 45 x 30 mm"
        *PageDimensions: PAIR(360, 240)
        *PrintableArea: PAIR(360, 240)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option16
    {
        *Name: "D 45 x 60 mm"
        *PageDimensions: PAIR(360, 480)
        *PrintableArea: PAIR(360, 480)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option17
    {
        *Name: "D 45 x 80 mm"
        *PageDimensions: PAIR(360, 640)
        *PrintableArea: PAIR(360, 640)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option18
    {
        *Name: "D 45 x 100 mm"
        *PageDimensions: PAIR(360, 800)
        *PrintableArea: PAIR(360, 800)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option19
    {
        *Name: "E 50 x 30 mm"
        *PageDimensions: PAIR(384, 240)
        *PrintableArea: PAIR(384, 240)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option20
    {
        *Name: "E 50 x 40 mm"
        *PageDimensions: PAIR(384, 320)
        *PrintableArea: PAIR(384, 320)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option21
    {
        *Name: "E 50 x 70 mm"
        *PageDimensions: PAIR(384, 560)
        *PrintableArea: PAIR(384, 560)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option22
    {
        *Name: "E 50 x 80 mm"
        *PageDimensions: PAIR(384, 640)
        *PrintableArea: PAIR(384, 640)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option23
    {
        *Name: "E 50 x 90 mm"
        *PageDimensions: PAIR(384, 720)
        *PrintableArea: PAIR(384, 720)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option24
    {
        *Name: "TV 38-25+40 mm"
        *PageDimensions: PAIR(200, 624)
        *PrintableArea: PAIR(200, 624)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option25
    {
        *Name: "TV 45-30+35 mm"
        *PageDimensions: PAIR(240, 640)
        *PrintableArea: PAIR(240, 640)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option26
    {
        *Name: "TV 64-32+35 mm"
        *PageDimensions: PAIR(256, 792)
        *PrintableArea: PAIR(256, 792)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: CUSTOMSIZE
    {
        *rcNameID: =USER_DEFINED_SIZE_DISPLAY
        *MinSize: PAIR(80, 80)
        *MaxSize: PAIR(16000, 16000)
        *MaxPrintableWidth: 16000
        *MinLeftMargin: 0
        *CenterPrintable?: FALSE
    }
}

*%******************************************************************************************
*%                                      Color Mode
*%******************************************************************************************
*Feature: ColorMode
{
	*rcNameID: =COLOR_PRINTING_MODE_DISPLAY
	*DefaultOption: Color
*%    *Option: Mono
*%    {
*%        *rcNameID: =MONO_DISPLAY
*%        *IPCallbackID: 1
*%        *DevNumOfPlanes: 1
*%        *DevBPP: 1
*%        *Color? : FALSE
*%    }
    *Option: Color
    {
        *rcNameID: =24BPP_DISPLAY
        *IPCallbackID: 5
        *DevNumOfPlanes: 0
        *DevBPP: 0
        *DrvBPP: 24
        *Color?: TRUE
    }
}

*%******************************************************************************************
*%                                      HalfTone
*%******************************************************************************************
*%*Feature: Halftone
*%{
*%    *rcNameID: =HALFTONING_DISPLAY
*%    *DefaultOption: HT_PATSIZE_AUTO
*%    *Option: HT_PATSIZE_AUTO
*%    {
*%        *rcNameID: =HT_AUTO_SELECT_DISPLAY
*%    }
*%    *Option: HT_PATSIZE_SUPERCELL_M
*%    {
*%        *rcNameID: =HT_SUPERCELL_DISPLAY
*%    }
*%    *Option: HT_PATSIZE_6x6_M
*%    {
*%        *rcNameID: =HT_DITHER6X6_DISPLAY
*%    }
*%    *Option: HT_PATSIZE_8x8_M
*%    {
*%        *rcNameID: =HT_DITHER8X8_DISPLAY
*%    }
*%}

*%******************************************************************************************
*%                                      Cursor and Page Commands
*%******************************************************************************************
*Command: CmdCR { *Cmd : "" }
*Command: CmdLF { *Cmd : "" }
*Command: CmdFF { *Cmd : "" }
