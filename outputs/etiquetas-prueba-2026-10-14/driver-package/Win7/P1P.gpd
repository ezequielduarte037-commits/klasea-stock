*GPDFileName: "P1P.gpd"
*GPDFileVersion: "1.0"
*GPDSpecVersion: "1.0"
*Include: "StdNames.gpd"
*ModelName: "P1P Label Printer"
*MasterUnits: PAIR(300, 300)
*ResourceDLL: "P1PUI.dll"
*PrinterType: PAGE
*MaxCopies: 9999
*%rcPrinterIconID:

*%******************************************************************************************
*%                                      Orientation
*%******************************************************************************************
*Feature: Orientation
{
    *rcNameID: =ORIENTATION_DISPLAY
    *DefaultOption: PORTRAIT
    *Option: PORTRAIT
    {
        *rcNameID: =PORTRAIT_DISPLAY
    }
    *Option: LANDSCAPE_CC270
    {
        *rcNameID: =LANDSCAPE_DISPLAY
    }
}

*%******************************************************************************************
*%                                      InputBin
*%******************************************************************************************
*Feature: InputBin
{
    *rcNameID: =PAPER_SOURCE_DISPLAY
    *DefaultOption: UPPER
    *Option: UPPER
    {
        *rcNameID: =UPPER_TRAY_DISPLAY
    }
}

*%******************************************************************************************
*%                                      Resolution
*%******************************************************************************************
*Feature: Resolution
{
    *rcNameID: =RESOLUTION_DISPLAY
    *DefaultOption: Option1
    *Option: Option1
    {
        *Name: "300 x 300" =DOTS_PER_INCH
        *DPI: PAIR(300, 300)
        *TextDPI: PAIR(300, 300)
        *PinsPerLogPass: 24
		*MinStripBlankPixels: 32
        *SpotDiameter: 170
        *Command: CmdSendBlockData { *Cmd : "" }
    }
}

*%******************************************************************************************
*%                                      Paper Size
*%******************************************************************************************
*Feature: PaperSize
{
    *rcNameID: =PAPER_SIZE_DISPLAY
    *DefaultOption: Option0
    *Option: Option0
    {
        *Name: "A 50 x  300 mm"
        *PageDimensions: PAIR(576, 3543)
        *PrintableArea: PAIR(576, 3543)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option1
    {
        *Name: "A 50 x 2000 mm"
