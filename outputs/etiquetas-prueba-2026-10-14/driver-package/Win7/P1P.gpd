    {
        *Name: "E 50 x 80 mm"
        *PageDimensions: PAIR(576, 945)
        *PrintableArea: PAIR(576, 945)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option23
    {
        *Name: "E 50 x 90 mm"
        *PageDimensions: PAIR(576, 1063)
        *PrintableArea: PAIR(576, 1063)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option24
    {
        *Name: "TV 38-25+40 mm"
        *PageDimensions: PAIR(295, 921)
        *PrintableArea: PAIR(295, 921)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option25
    {
        *Name: "TV 45-30+35 mm"
        *PageDimensions: PAIR(354, 945)
        *PrintableArea: PAIR(354, 945)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option26
    {
        *Name: "TV 64-32+35 mm"
        *PageDimensions: PAIR(378, 1169)
        *PrintableArea: PAIR(378, 1169)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: CUSTOMSIZE
    {
        *rcNameID: =USER_DEFINED_SIZE_DISPLAY
        *MinSize: PAIR(120, 120)
        *MaxSize: PAIR(24000, 24000)
        *MaxPrintableWidth: 24000
        *MinLeftMargin: 0
        *CenterPrintable?: FALSE
		
        *% Allow the driver to directly use the incoming paper size
        *CustPrintableOriginX: %d{0}
        *CustPrintableOriginY: %d{0}
        *CustPrintableSizeX:  %d{PhysPaperWidth}
        *CustPrintableSizeY:  %d{PhysPaperLength}
        *CustCursorOriginX:  %d{0}
        *CustCursorOriginY:  %d{0}
		
        *% empty command is better than none at all.
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.13
            *Cmd: ""
        }
    }
}

*%******************************************************************************************
*%                                      Color Mode
*%******************************************************************************************
*Feature: ColorMode
{
	*rcNameID: =COLOR_PRINTING_MODE_DISPLAY
	*DefaultOption: Color
*%    *Option: Mono
*%    {
*%        *rcNameID: =MONO_DISPLAY
*%        *IPCallbackID: 1
*%        *DevNumOfPlanes: 1
*%        *DevBPP: 1
*%        *Color? : FALSE
*%    }
    *Option: Color
    {
        *rcNameID: =24BPP_DISPLAY
        *IPCallbackID: 5
        *DevNumOfPlanes: 0
        *DevBPP: 0
        *DrvBPP: 24
        *Color?: TRUE
    }
}

*%******************************************************************************************
*%                                      HalfTone
*%******************************************************************************************
*%*Feature: Halftone
*%{
*%    *rcNameID: =HALFTONING_DISPLAY
*%    *DefaultOption: HT_PATSIZE_AUTO
*%    *Option: HT_PATSIZE_AUTO
*%    {
