    }
    *Option: Option12
    {
        *Name: "D 40 x 70 mm"
        *PageDimensions: PAIR(472, 827)
        *PrintableArea: PAIR(472, 827)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option13
    {
        *Name: "D 40 x 80 mm"
