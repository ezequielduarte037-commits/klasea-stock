        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option17
    {
        *Name: "D 45 x 80 mm"
        *PageDimensions: PAIR(531, 945)
        *PrintableArea: PAIR(531, 945)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option18
    {
        *Name: "D 45 x 100 mm"
        *PageDimensions: PAIR(531, 1181)
        *PrintableArea: PAIR(531, 1181)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option19
    {
        *Name: "E 50 x 30 mm"
        *PageDimensions: PAIR(576, 354)
        *PrintableArea: PAIR(576, 354)
        *PrintableOrigin: PAIR(0, 0)
    }
    *Option: Option20
    {
