; P1.INF
;
; INF file for the base WDK sample
;
; Copyright 2011 - 2026 ThanMore Corporation


[Version]
Signature="$Windows NT$"
Provider=%OEM%
LayoutFile=ntprint.inf
ClassGUID={4D36E979-E325-11CE-BFC1-08002BE10318}
Class=Printer
CatalogFile=P1.cat
; mm/dd/yyyy,x.x.yyyy.mmdd
DriverVer=05/08/2026,2.1.2026.0508
; specify PnpLockdown=1 to prevent external apps from modifying installed driver files
PnpLockdown=1

;
; Manufacturer section.
;
; This section lists all of the manufacturers 
; that we will display in the Dialog box
;
[Manufacturer]
%OEM%=DeTong_Printers, NTx86, NTamd64, NTarm64

;
; OEM URLS
;
; This sections gives the URL for manufacturers found in the Manufacturers section
;
[OEM URLS]
%OEM%="https://www.detonger.com/"

;
; Model sections. 
; 
; Each section here corresponds with an entry listed in the
; [Manufacturer] section, above. The models will be displayed in the order
; that they appear in the INF file.
;

; [DeTong_Printers]
; %DeviceDesc_DP23S%       = INSTALL_P1S, USBPRINT\DeTong_DP20_Label_Pr37D2, DeTong_DP20_Label_Pr37D2
; %DeviceDesc_DP26S%       = INSTALL_P1S, USBPRINT\DeTong_DP26_Label_Pr92B4, DeTong_DP26_Label_Pr92B4
; %DeviceDesc_P1S%         = INSTALL_P1S, USBPRINT\DeTong_P1_Label_Prin6207, DeTong_P1_Label_Prin6207
; %DeviceDesc_DP23P%       = INSTALL_P1P, USBPRINT\DeTong_DP23P_Label_PD899, DeTong_DP23P_Label_PD899
; %DeviceDesc_DP23P%       = INSTALL_P1P, USBPRINT\DeTong_DP23PLUS_LabeD37B, DeTong_DP23PLUS_LabeD37B
; %DeviceDesc_DP26P%       = INSTALL_P1P, USBPRINT\DeTong_DP26P_Label_P8B80, DeTong_DP26P_Label_P8B80
; %DeviceDesc_P1P%         = INSTALL_P1P, USBPRINT\DeTong_P1P_Label_PriCF97, DeTong_P1P_Label_PriCF97

[DeTong_Printers.NTx86]
%DeviceDesc_DP23S%       = INSTALL_P1S, USBPRINT\DeTong_DP20_Label_Pr37D2, DeTong_DP20_Label_Pr37D2
%DeviceDesc_DP26S%       = INSTALL_P1S, USBPRINT\DeTong_DP26_Label_Pr92B4, DeTong_DP26_Label_Pr92B4
%DeviceDesc_P1S%         = INSTALL_P1S, USBPRINT\DeTong_P1_Label_Prin6207, DeTong_P1_Label_Prin6207
%DeviceDesc_DP23P%       = INSTALL_P1P, USBPRINT\DeTong_DP23P_Label_PD899, DeTong_DP23P_Label_PD899
%DeviceDesc_DP23P%       = INSTALL_P1P, USBPRINT\DeTong_DP23PLUS_LabeD37B, DeTong_DP23PLUS_LabeD37B
%DeviceDesc_DP26P%       = INSTALL_P1P, USBPRINT\DeTong_DP26P_Label_P8B80, DeTong_DP26P_Label_P8B80
%DeviceDesc_P1P%         = INSTALL_P1P, USBPRINT\DeTong_P1P_Label_PriCF97, DeTong_P1P_Label_PriCF97

[DeTong_Printers.NTamd64]
%DeviceDesc_DP23S%       = INSTALL_P1S, USBPRINT\DeTong_DP20_Label_Pr37D2, DeTong_DP20_Label_Pr37D2
%DeviceDesc_DP26S%       = INSTALL_P1S, USBPRINT\DeTong_DP26_Label_Pr92B4, DeTong_DP26_Label_Pr92B4
%DeviceDesc_P1S%         = INSTALL_P1S, USBPRINT\DeTong_P1_Label_Prin6207, DeTong_P1_Label_Prin6207
%DeviceDesc_DP23P%       = INSTALL_P1P, USBPRINT\DeTong_DP23P_Label_PD899, DeTong_DP23P_Label_PD899
%DeviceDesc_DP23P%       = INSTALL_P1P, USBPRINT\DeTong_DP23PLUS_LabeD37B, DeTong_DP23PLUS_LabeD37B
%DeviceDesc_DP26P%       = INSTALL_P1P, USBPRINT\DeTong_DP26P_Label_P8B80, DeTong_DP26P_Label_P8B80
%DeviceDesc_P1P%         = INSTALL_P1P, USBPRINT\DeTong_P1P_Label_PriCF97, DeTong_P1P_Label_PriCF97

[DeTong_Printers.NTarm64]
%DeviceDesc_DP23S%       = INSTALL_P1S, USBPRINT\DeTong_DP20_Label_Pr37D2, DeTong_DP20_Label_Pr37D2
%DeviceDesc_DP26S%       = INSTALL_P1S, USBPRINT\DeTong_DP26_Label_Pr92B4, DeTong_DP26_Label_Pr92B4
%DeviceDesc_P1S%         = INSTALL_P1S, USBPRINT\DeTong_P1_Label_Prin6207, DeTong_P1_Label_Prin6207
%DeviceDesc_DP23P%       = INSTALL_P1P, USBPRINT\DeTong_DP23P_Label_PD899, DeTong_DP23P_Label_PD899
%DeviceDesc_DP23P%       = INSTALL_P1P, USBPRINT\DeTong_DP23PLUS_LabeD37B, DeTong_DP23PLUS_LabeD37B
%DeviceDesc_DP26P%       = INSTALL_P1P, USBPRINT\DeTong_DP26P_Label_P8B80, DeTong_DP26P_Label_P8B80
%DeviceDesc_P1P%         = INSTALL_P1P, USBPRINT\DeTong_P1P_Label_PriCF97, DeTong_P1P_Label_PriCF97

;
; Installer Sections
;
; These sections control file installation, and reference all files that
; need to be copied. The section name will be assumed to be the driver
; file, unless there is an explicit DriverFile section listed.
; ====================================
; ===== Start Installer Sections =====
; ====================================

; ******************************
; ***** install P1 driver
; ******************************

[INSTALL_P1S]
CopyFiles=@P1.GPD
CopyFiles=@P1.INI
CopyFiles=BMP_P1S
DataFile=P1.GPD
DataSection=UNIDRV_DATA
Include=NTPRINT.INF
Needs=UNIDRV.OEM,UNIDRV_DATA

; associated service to Hardware 'xxx Label Printer' using install section 'INSTALL_XXX'.
[INSTALL_P1S.Services]
AddService=, 2

[BMP_P1S]
P1.DLL
P1UI.DLL

; ******************************
; ***** install P1P driver
; ******************************

[INSTALL_P1P]
CopyFiles=@P1P.GPD
CopyFiles=@P1P.INI
CopyFiles=BMP_P1P
DataFile=P1P.GPD
DataSection=UNIDRV_DATA
Include=NTPRINT.INF
Needs=UNIDRV.OEM,UNIDRV_DATA

; associated service to Hardware 'xxx Label Printer' using install section 'INSTALL_XXX'.
[INSTALL_P1P.Services]
AddService=, 2

[BMP_P1P]
P1P.DLL
P1PUI.DLL

; ====================================
; ===== End Installer Sections =====
; ====================================

; Copy Sections
;
; Lists of files that are actually copied. These sections are referenced
; from the installer sections, above. Only create a section if it contains
; two or more files (if we only copy a single file, identify it in the
; installer section, using the @filename notation) or if it's a color
; profile (since the DestinationDirs can only handle sections, and not
; individual files).
;

;
; Data Sections
;

; These sections contain data that is shared between devices.
;



;
;  Location of source files not in Layout.inf.
;

[SourceDisksNames]
100 = %Disk1%

[SourceDisksFiles.x86]
P1.dll     = 100,x86
P1UI.dll   = 100,x86
P1P.dll     = 100,x86
P1PUI.dll   = 100,x86

[SourceDisksFiles.amd64]
P1.dll     = 100,amd64
P1UI.dll   = 100,amd64
P1P.dll     = 100,amd64
P1PUI.dll   = 100,amd64

[SourceDisksFiles.arm64]
P1.dll     = 100,arm64
P1UI.dll   = 100,arm64
P1P.dll     = 100,arm64
P1PUI.dll   = 100,arm64

[SourceDisksFiles]
P1.GPD     = 100
P1.INI     = 100
P1P.GPD     = 100
P1P.INI     = 100

;
; Call SetupSetDirectoryId with 66000 to set the target directory at runtime
; (depending on which environment drivers are getting installed)
;

[DestinationDirs]
DefaultDestDir=66000

;
; Localizable Strings
;
[Strings]
OEM="DeTong, Shanghai, Inc."
DeviceDesc_DP23S="DP23 Label Printer"
DeviceDesc_DP26S="DP26 Label Printer"
DeviceDesc_P1S="P1 Label Printer"
DeviceDesc_DP23P="DP23P Label Printer"
DeviceDesc_DP26P="DP26P Label Printer"
DeviceDesc_P1P="P1P Label Printer"
;
Disk1="DeTong P1 Driver Setup Disk"
