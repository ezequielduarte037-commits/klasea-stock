# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env
.env.*
# El backup de Supabase lee las credenciales de este archivo temporal y lo borra
# al terminar. Si el dump falla a mitad de camino, el archivo queda: que no se
# pueda commitear una contraseña de producción por accidente.
backups/supabase-dryrun-*.txt
# El volcado de datos queda en disco pero no entra al repo: son datos de
# producción y el historial de git no es lugar para eso.
backups/rest-*/
# Respaldos de comprobantes borrados: son PDFs de proveedores reales.
backups/remitos-*/
# Build del puente NFC (tools/nfc-bridge)
tools/nfc-bridge/bin/
tools/nfc-bridge/obj/

# Estado local de las herramientas de IA (ruflo, codex, swarm). Es cache y base
# de datos de la máquina, no del proyecto: si se commitea, cada PC pisa la del
# resto y el repo engorda sin motivo.
.swarm/
.agents/
.codex/
.claude-flow/
ruvector.db
*.ruvector.db

# Paquetes offline con instaladores de terceros (Node, NAPS2 y Pantum).
# Se regeneran con tools/scanner-bridge/crear-paquete-panol.ps1.
entregables/instalador-panol/
